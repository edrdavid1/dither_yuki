{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dither Yuki",
  "version": "2.0.0-beta",
  "identifier": "com.ditheryuki",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dither Yuki",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Dither Yuki",
    "publisher": "L'eco non di Bergamo",
    "targets": ["dmg", "app"],
    "externalBin": [
      "../bin/ffmpeg",
      "../bin/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dyproj"],
        "name": "Dither Yuki Project",
        "description": "Professional dithering and image processing tool with retro aesthetics.",
        "role": "Editor"
      },
      {
        "ext": ["dyuki"],
        "name": "Dither Yuki Pattern Preset",
        "description": "Dither Yuki Shareable Pattern Preset",
        "role": "Editor"
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Resources/dyproj.icns": "../dist/dyproj.icns",
        "Resources/dyuki.icns": "../dist/dyuki.icns"
      }
    }
  }
}
