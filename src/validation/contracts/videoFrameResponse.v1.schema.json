{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ditheryuki.app/schemas/video-frame-response.v1.schema.json",
  "title": "VideoFrameResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "videoId", "frameIndex", "width", "height", "rgba", "cacheHit", "processingMs", "backendUsed", "fallbackUsed"],
  "properties": {
    "version": { "const": 1 },
    "videoId": { "type": "string", "minLength": 1 },
    "frameIndex": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "rgba": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "cacheHit": { "type": "boolean" },
    "processingMs": { "type": "number", "minimum": 0 },
    "backendUsed": { "type": "string", "enum": ["cpu", "gpu"] },
    "fallbackUsed": { "type": "boolean" }
  }
}

