{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ditheryuki.app/schemas/backend-effect-layer-payload.schema.json",
  "title": "BackendEffectLayerPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "algorithm", "enabled", "intensity"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "intensity": { "type": "number" },
    "blend_mode": { "type": "string" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "palette_name": { "type": "string" },
    "palette": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "contrast": { "type": "number" },
    "brightness": { "type": "number" },
    "saturation": { "type": "number" },
    "pixel_size": { "type": "number" },
    "blur": { "type": "number" },
    "sharpness": { "type": "number" },
    "noise": { "type": "number" },
    "glitch_type": { "type": "string" },
    "sort_by": { "type": "string" },
    "masking": { "type": "string" },
    "mask_target": { "type": "string" },
    "mask_feather": { "type": "number" },
    "threshold_min": { "type": "number" },
    "threshold_max": { "type": "number" },
    "direction_angle": { "type": "number" },
    "sort_length": { "type": "number" },
    "block_size": { "type": "number" },
    "chaos": { "type": "number" },
    "quantization": { "type": "number" },
    "red_shift_x": { "type": "number" },
    "red_shift_y": { "type": "number" },
    "green_shift_x": { "type": "number" },
    "green_shift_y": { "type": "number" },
    "blue_shift_x": { "type": "number" },
    "blue_shift_y": { "type": "number" },
    "global_rgb_shift_intensity": { "type": "number" },
    "slice_count": { "type": "number" },
    "max_offset": { "type": "number" },
    "randomness": { "type": "number" },
    "scanline_thickness": { "type": "number" },
    "scanline_gap": { "type": "number" },
    "flicker": { "type": "number" },
    "curvature": { "type": "number" },
    "snap_to_palette": { "type": "boolean" },
    "palette_mix": { "type": "number" },
    "global_seed": { "type": "number" },
    "mask_r": { "type": "boolean" },
    "mask_g": { "type": "boolean" },
    "mask_b": { "type": "boolean" },
    "mask_a": { "type": "boolean" }
  }
}

